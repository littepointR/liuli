MEMORY {
  FLASH : ORIGIN = 0x08000000, LENGTH = 2048K
  REPORT : ORIGIN = 0x24000000, LENGTH = LIULI_REPORT_BYTES
  RAM : ORIGIN = 0x24000000 + LIULI_REPORT_BYTES, LENGTH = 512K - LIULI_REPORT_BYTES
}
_stack_end = 0x20000000;
_stack_start = 0x20020000;
_ui_heap_start = ALIGN(__euninit, 8);
_ui_heap_end = ORIGIN(RAM) + LENGTH(RAM);
SECTIONS { .report (NOLOAD) : { KEEP(*(.report)) } > REPORT } INSERT AFTER .uninit;
ASSERT(SIZEOF(.report) == LIULI_REPORT_BYTES, "J-Link report ABI");
